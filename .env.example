# Copie para .env e ajuste. Usado pelo docker-compose.
# DB_USER/DB_PASSWORD = dono do banco (admin/backup).
DB_NAME=gestao
DB_USER=dual
DB_PASSWORD=gestao2026
DB_PORT=5433

# Role de APLICAÇÃO (só DML) com que a API conecta — NÃO é o dono do banco.
# Evite aspas simples na senha.
APP_DB_USER=gestao_app
APP_DB_PASSWORD=troque_esta_senha_app

API_PORT=8010
JWT_SECRET=troque-este-segredo-em-producao
JWT_TTL_SECONDS=28800     # 8h. Menor = mais seguro; logout revoga na hora.

# Domínio público (atrás do proxy nginx). Ver DEPLOY.md.
PUBLIC_URL=https://gestao.dualcomunicacao.com.br
# Em produção, restrinja o CORS ao domínio (em vez de *):
CORS_ORIGINS=https://gestao.dualcomunicacao.com.br

# ── Primeiro administrador (login por NOME + senha, sem e-mail) ──
# O banco começa ZERADO (sem usuários). A API cria automaticamente
# este admin na primeira subida, enquanto não houver nenhum usuário.
# Troque em produção. Alternativa: crie via POST /auth/bootstrap.
ADMIN_NOME=yara
ADMIN_SENHA=1234

# Backup automático (serviço "backup")
BACKUP_INTERVAL=86400     # segundos entre dumps (86400 = 24h)
RETENTION_DAYS=14         # dias de retenção dos dumps em ./backups
